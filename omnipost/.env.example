# ==============================================================================
# Universal Multi-Platform Social Automation & Video Publishing Engine (.env.example)
# White-Label, Multi-Tenant & Platform-Agnostic Publishing Suite
# ==============================================================================

# ------------------------------------------------------------------------------
# 0. Brand & Platform Customization (White-Label & Universal Integration)
# ------------------------------------------------------------------------------
# Name and subtitle displayed across the dashboard, login screen, and meta headers
APP_NAME=OmniPost Social Automation
APP_SUBTITLE=Universal Multi-Platform Content Publishing Engine
APP_ORGANIZATION=Digital Media Works

# Feature Toggles:
# Set to 'false' for generic publishing platforms.
# Set to 'true' only if you are running the legal chambers / client document vault.
ENABLE_CLIENT_VAULT=false

# Default Quick Tags (comma-separated hashtags available in content composer)
DEFAULT_HASHTAGS=#Video,#Trending,#ContentCreator,#SocialMedia,#Automation

# Placeholder text customized for your company or creator niche
CAPTION_PLACEHOLDER=Write compelling post copy, keywords, hashtags, call-to-action, or links...
TITLE_PLACEHOLDER=e.g., Video Showcase / Product Update / Behind the Scenes

# Inbound & Outbound Webhooks:
# URL where this engine sends an event notification whenever a post is published
PUBLISH_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 1. Core Service URLs & Settings
# ------------------------------------------------------------------------------
TIMEZONE=Asia/Kolkata
GENERIC_TIMEZONE=Asia/Kolkata
TZ=Asia/Kolkata

# ------------------------------------------------------------------------------
# PUBLIC URLS -- the ONLY place a hostname should ever appear.
#
# Everything else (docker-compose, service-manager.ps1, OAuth callbacks, webhook
# base URLs) derives from these four values. To go to production, change only
# this block:
#   N8N_PUBLIC_URL=https://n8n.yourdomain.com
#   WEB_PORTAL_PUBLIC_URL=https://app.yourdomain.com
#
# No trailing slashes.
#
# After changing these, update the OAuth redirect URIs to match:
#   Google Cloud Console -> {N8N_PUBLIC_URL}/rest/oauth2-credential/callback
#   Meta / Pinterest / LinkedIn consoles -> their respective callback paths
# ------------------------------------------------------------------------------
# Public https address of the workflow hub. n8n hands this to Google and Meta
# as the OAuth redirect and webhook base - if it stays localhost, OAuth fails
# silently at the callback.
N8N_PUBLIC_URL=http://localhost:5678
# Production: https://n8n.yourdomain.com
#
# Container-to-container address, tried first (no public hop, no TLS handshake).
N8N_INTERNAL_URL=http://n8n:5678
#
# Shared secret the portal sends to n8n as the X-OmniPost-Webhook-Key header. Must
# equal the value of the "OmniPost Webhook Key" Header Auth credential in
# n8n, which every workflow webhook requires. Generate: openssl rand -hex 32
N8N_WEBHOOK_SECRET=CHANGE_ME_openssl_rand_hex_32
#
# The n8n editor holds live Google/Meta credentials - never leave it open.
# (N8N_BASIC_AUTH_USER / _PASSWORD removed: n8n 1.x dropped basic auth in
#  favour of built-in user management, which 2.x keeps always on.)
#
# Extra browser origins allowed to call the API (comma separated, exact match).
# The built-in list is exact too: yourdomain.com, www., admin., n8n. and the
# service's own Render URL. Wildcard subdomains are no longer accepted.
CORS_EXTRA_ORIGINS=
WEB_PORTAL_PUBLIC_URL=http://localhost:3300

# n8n Configuration
# N8N_HOST/PORT/PROTOCOL control how n8n binds inside its container --
# they are NOT the public address. Use N8N_PUBLIC_URL for that.
N8N_HOST=localhost
N8N_PORT=5678
N8N_PROTOCOL=http
# Encrypts every stored n8n credential - and, on 2.x, n8n's own deployment keys
# in the database, which it refuses to start without being able to read.
# Generate once, back it up with the database password, never change it on a
# populated database:   openssl rand -hex 32
# (This template used to carry a concrete value. Anything published in this
# repository is not a secret; compose refuses to start with this left empty.)
N8N_ENCRYPTION_KEY=
N8N_ENFORCE_SETTINGS_FILE_PERMISSIONS=true
N8N_DEFAULT_BINARY_DATA_MODE=filesystem

# Advocate Content Portal (Express serves the React build + API on one port)
WEB_PORT=3300
# Master Secret Passkey (protects admin.yourdomain.com & /api/upload & /api/posts)
# ------------------------------------------------------------------------------
# ROLE-SEPARATED ACCESS KEYS
#
# Two distinct people, two distinct keys. A social media assistant with the
# automation key must NEVER be able to open a client's will, testator PII or a
# partition deed. (Enforced by the API's RBAC, whichever domain is used.)
#
#   CHAMBERS_ADMIN_SECRET_KEY  the advocate / chambers staff.
#                              Opens the legal vault AND publishing (superset).
#   AUTOMATION_SECRET_KEY      whoever schedules posts. Publishing ONLY.
#
# Generate strong, DIFFERENT values:
#   openssl rand -base64 32
#
# ADMIN_SECRET_KEY below is the legacy single key. It is still honoured as the
# chambers key so an existing deployment keeps working, but set the two keys
# above instead and remove it.
# ------------------------------------------------------------------------------
CHAMBERS_ADMIN_SECRET_KEY=CHANGE_ME_openssl_rand_base64_32
AUTOMATION_SECRET_KEY=CHANGE_ME_DIFFERENT_openssl_rand_base64_32
ADMIN_SECRET_KEY=omnipost-secure-admin-2026

STORAGE_PROVIDER=local
UPLOAD_DIRECTORY=/uploads

# ------------------------------------------------------------------------------
# 2. Database & Infrastructure Credentials (Internal Docker Network)
# ------------------------------------------------------------------------------

# ------------------------------------------------------------------------------
# 3. Social Media Channel API Credentials (6 Target Platforms)
# ------------------------------------------------------------------------------

# --- [Platform 1]: Telegram (Bot Token from @BotFather) ---
# Easiest: 0 OAuth required, works immediately on localhost
TELEGRAM_BOT_NAME=
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=

# --- [Platform 2 & 3]: Meta (Instagram Professional & Facebook Page) ---
# Single Meta Developer App serves both Instagram and Facebook
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# --- [Platform 4]: YouTube (Google Cloud Console -> YouTube Data API v3) ---
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=

# --- [Platform 5]: LinkedIn (LinkedIn Developer Portal) ---
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# --- [Platform 6]: Pinterest (Pinterest Developer Portal) ---
PINTEREST_CLIENT_ID=
PINTEREST_CLIENT_SECRET=

# --- Optional Channels: X (Twitter) & Threads ---
X_URL=
X_API_KEY=
X_API_SECRET=
THREADS_APP_ID=
THREADS_APP_SECRET=

# ------------------------------------------------------------------------------
# [OPTIONAL / DIRECT API RESERVED]
# client ID/secret pairs above. Populate these only if you build a direct
# ------------------------------------------------------------------------------
# --- RUNTIME PUBLISHING CREDENTIALS -------------------------------------------
# These are what publishing/registry.js actually reads to decide whether a
# channel is "connected". Everything above this line is app-registration
# material used to MINT them; none of it publishes anything on its own.
# Without the values below the pre-flight reports NEEDS_CONFIGURATION and the
# engine never reaches GREEN_SIGNAL, so they were the one group this file was
# missing.

# Facebook Page + Instagram share one Page access token.
#   facebook  requires FACEBOOK_PAGE_ID + FACEBOOK_PAGE_ACCESS_TOKEN
#   instagram requires INSTAGRAM_BUSINESS_ACCOUNT_ID + FACEBOOK_PAGE_ACCESS_TOKEN
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ACCOUNT_ID=

# Display labels only - shown in the channel inventory, never used to publish.
FACEBOOK_PAGE_NAME=
INSTAGRAM_USERNAME=

# Graph API version used by every Meta call. Pin it: Meta deprecates versions
# on a schedule and an unpinned default silently changes behaviour.
META_GRAPH_VERSION=v21.0

# threads requires both.
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# --- Optional channels --------------------------------------------------------
# Absent values simply report NEEDS_CONFIGURATION; they never block the engine.
# Nothing else needs to change to turn a channel on - add the values below and
# the next pre-flight (or the next publish) picks them up.
#   linkedin  requires LINKEDIN_ACCESS_TOKEN + LINKEDIN_AUTHOR_URN
#   pinterest requires PINTEREST_ACCESS_TOKEN + PINTEREST_BOARD_ID

# A token with the w_organization_social scope (to post as the firm's Company
# Page) or w_member_social (to post as a person). Minted via LinkedIn's OAuth
# 2.0 flow in the Developer Portal (developer.linkedin.com); LinkedIn access
# tokens for the versioned /rest/ API expire in 60 days and must be refreshed
# by re-running that flow - there is no long-lived server-to-server credential
# here.
LINKEDIN_ACCESS_TOKEN=
# WHO the post is published as - format matters, publishing/linkedin.js
# rejects anything else:
#   urn:li:organization:<id>   post as the firm's Company Page (the practice's
#                               actual use case). <id> is the numeric id shown
#                               in the URL of the page's admin view
#                               (linkedin.com/company/<slug>/admin/...) and in
#                               LinkedIn's organizationAcls API response - it
#                               is NOT the page's URL slug.
#   urn:li:person:<id>         post as an individual. <id> is the `sub` claim
#                               returned by GET /v2/userinfo for that user's
#                               token (LinkedIn's OpenID Connect endpoint).
LINKEDIN_AUTHOR_URN=
# Display label only, never used to authenticate. Without it the pre-flight
# still shows a real name when it can get one from LinkedIn's userinfo
# response, but that is the ADMIN who authorised the app, not the page - for
# an organization URN this label is what shows the firm's actual name instead.
LINKEDIN_DISPLAY_NAME=
PINTEREST_ACCESS_TOKEN=
PINTEREST_BOARD_ID=
# Display label only, never used to authenticate - shown in the channel
# inventory and the composer UI so staff see a human name instead of a raw
# board id. This account has exactly one target board, so it is set once here
# rather than typed per post.
PINTEREST_BOARD_NAME=

# --- n8n persistence: Supabase Postgres --------------------------
# n8n stores its workflows, executions and ENCRYPTED credentials here, in its
# own `n8n` schema so they never mix with the legal tables in `public`.
# Run automation/supabase/n8n-schema.sql ONCE before first boot.
#
# Take these from: Supabase dashboard -> Connect -> Session pooler.
#
#   HOST must be the SESSION POOLER, not db.<ref>.supabase.co. The direct host
#   resolves to IPv6 only on the free tier, and a Docker bridge network has no
#   IPv6 route - verified UNREACHABLE from a container. The pooler is IPv4.
#
#   PORT 5432 = session mode (correct). 6543 on the same host is TRANSACTION
#   mode, which does not keep session state; n8n's TypeORM migrations need
#   prepared statements and advisory locks and will fail against it.
#
#   USER is "postgres.<project-ref>" on the pooler - the suffix is required.
#
#   PASSWORD is the DATABASE password (Settings -> Database), which is a
#   DIFFERENT credential from SUPABASE_SERVICE_ROLE_KEY. The service-role key
#   is a PostgREST API key and will not authenticate a Postgres connection.
#
#   AVOID '$' IN THIS PASSWORD. Docker Compose's own variable interpolation
#   substitutes this value into docker-compose.yml / docker-compose.prod.yml
#   as ${SUPABASE_DB_PASSWORD}, and Compose re-scans the substituted text for
#   further $name patterns - a password containing '$' gets silently
#   truncated at the '$' (verified: a 25-char password became 10 chars, with
#   no error, just a quiet warning about an unrelated undefined variable).
#   render.yaml is unaffected (Render's dashboard takes the raw value with no
#   interpolation), but since the same .env drives both paths, keep the
#   password Compose-safe: letters, digits, and punctuation from
#   # @ - _ . + = ! is fine; avoid $ ` \ " '.
# Confirmed live on 2026-09-15 from Supabase -> Connect -> Session pooler for
# this project (cmjhgvhtlpayjcrsqgox): ap-northeast-2 (Seoul), not ap-south-1 -
# the region is assigned per-project, so always read it off YOUR dashboard
# rather than copying this value.
#
#   Use the pooler NAME, never the AWS load balancer it CNAMEs to
#   (pool-tcp-...elb.amazonaws.com). The pooler's TLS certificate covers
#   *.pooler.supabase.com only, so the ELB name can never be verified - and
#   n8n now verifies it: the compose files mount
#   supabase/supabase-root-2021-ca.crt (Supabase's public root CA) and set
#   DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true.
SUPABASE_DB_HOST=aws-0-ap-northeast-2.pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.cmjhgvhtlpayjcrsqgox
SUPABASE_DB_PASSWORD=
SUPABASE_DB_SCHEMA=n8n
# 4, not 2: with 2, n8n's own health ping plus one slow query starves every
# other query on a slow CPU. See the pool block in render.yaml.
SUPABASE_DB_POOL_SIZE=4

# Execution history shares the 500MB free tier with the client legal tables,
# so pruning is a capacity control here, not housekeeping.
N8N_EXECUTIONS_MAX_AGE_HOURS=168
N8N_EXECUTIONS_MAX_COUNT=2000

# --- Chambers document vault --------------------------------------------------
# How long a signed /uploads document link stays valid, in seconds. These links
# are minted only inside chambers-authenticated responses; the default is one
# hour, which outlasts a review session without leaving a usable link in a
# browser history forever.
VAULT_URL_TTL_SECONDS=3600

# ------------------------------------------------------------------------------
# 4. AI & Content Automation Settings
# ------------------------------------------------------------------------------
# OpenRouter API key (Used in n8n to extract Date/Time & assist caption drafting)
OPENROUTER_API_KEY=
# OpenAI API key (Optional alternative)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 5. Google Drive & Sheets Integration References
# Reference values only - these are entered directly into the Google Drive/Sheets
# nodes inside the n8n UI (along with the Google OAuth credential) and are not
# injected into any container via docker-compose.yml.
# ------------------------------------------------------------------------------
GOOGLE_DRIVE_FOLDER_ID=1SHI8YHrgHZEmVU30Jlr-FVDhqo-XZkSm
GOOGLE_SHEET_ID=

# ------------------------------------------------------------------------------
# 6. Supabase Cloud Database & Private Storage (Optional / Production)
# ------------------------------------------------------------------------------
SUPABASE_URL=https://cmjhgvhtlpayjcrsqgox.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=


# ------------------------------------------------------------------------------
# 7. Online fee payment (Razorpay) - OFF until the KVB current account and the
#    Razorpay merchant account are active. While off, the website shows the fee
#    schedule and the will intake completes with no checkout.
#    Switch on: set both keys, set ENABLE_ONLINE_PAYMENTS=true here (Render), and
#    VITE_ENABLE_RAZORPAY=true on the Vercel website build.
# ------------------------------------------------------------------------------
ENABLE_ONLINE_PAYMENTS=false
PAYMENT_BASE_FEE_INR=7999
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
