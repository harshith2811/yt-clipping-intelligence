    "Every 15 Minutes": { "main": [[{ "node": "Get Pending Review Rows", "type": "main", "index": 0 }]] },
    "Get Pending Review Rows": { "main": [[{ "node": "Oldest Pending Row", "type": "main", "index": 0 }]] },
    "Oldest Pending Row": { "main": [[{ "node": "Mark Awaiting Response", "type": "main", "index": 0 }]] },
    "Mark Awaiting Response": { "main": [[{ "node": "Send Approval Email", "type": "main", "index": 0 }]] },
    "Send Approval Email": { "main": [[{ "node": "Recheck Row", "type": "main", "index": 0 }]] },
    "Recheck Row": { "main": [[{ "node": "Still Awaiting Response?", "type": "main", "index": 0 }]] },
    "Still Awaiting Response?": { "main": [[{ "node": "Approved?", "type": "main", "index": 0 }], []] },
    "Approved?": {
      "main": [
        [{ "node": "Mark Approved", "type": "main", "index": 0 }],
        [{ "node": "Mark Rejected", "type": "main", "index": 0 }]
      ]
    }
  },
