# YouTube Clipping Intelligence Platform - Configuration Template
# Copy this file to .env and populate with operator credentials.
# NEVER commit real API keys or secrets to version control.

# YouTube Data API v3 Configuration (Primary metadata ingestion engine)
YOUTUBE_API_KEY=your_youtube_data_api_v3_key_here
YOUTUBE_DAILY_QUOTA_LIMIT=10000

# Google Gemini Cloud Intelligence (Multi-model highlight scoring & social caption synthesizer)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-3.5-flash-lite
GEMINI_FALLBACK_MODEL=gemini-flash-latest
GEMINI_MODEL=gemini-3.5-flash-lite

# Autonomous Pinger & Discovery Settings
PINGER_POLL_INTERVAL_SECONDS=300
ENABLE_WEBSUB=false
WEBSUB_PORT=8088

# Downstream Autopost Integration
AUTOPOST_MODE=watched_folder
AUTOPOST_WATCHED_DIR=data/autopost_inbox
AUTOPOST_WEBHOOK_URL=https://autopost.internal.local/api/v1/clips/ingest
AUTOPOST_WEBHOOK_BEARER_TOKEN=your_secure_bearer_token_here
AUTOPOST_DEFAULT_DRY_RUN=true

# Storage and Directories
DATA_DIR=data
ASSETS_DIR=data/assets
PROJECTS_DIR=data/projects
TRANSCRIPTS_DIR=data/transcripts
RENDERED_CLIPS_DIR=data/rendered_clips
RIGHTS_LEDGER_PATH=data/rights_ledger.json
JOBS_DB_PATH=data/jobs.db

# Media Processing Defaults
DEFAULT_LAYOUT_MODE=active_speaker
DEFAULT_SUBTITLE_PRESET=hormozi
DEFAULT_MIN_DURATION_SECONDS=15.0
DEFAULT_MAX_DURATION_SECONDS=60.0
CRF_QUALITY=22
AUTO_APPROVE_THRESHOLD=65.0
