# ==============================================================================
# YouTube Clipping Intelligence Platform - .gitignore
# Production-Grade Git Exclusion Matrix
# ==============================================================================

# --- Python Bytecode & Optimization ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# --- Distribution, Packaging & Build Artifacts ---
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Virtual Environments ---
.venv/
venv/
ENV/
env/
venv*/
ENV*/
env*/

# --- Testing, Coverage & Profiling ---
.pytest_cache/
.coverage
.coverage.*
htmlcov/
*.cover
*.py,cover
.hypothesis/
.nox/
.tox/

# --- Static Analysis & Linters ---
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# --- Multi-Agent Swarm, Subagent Logs & Scratchpads ---
.agents/
scratch/
*.tmp
*.bak
*.swp
*.swo

# --- Media Assets & Pipeline Storage ---
data/*
!data/**/.gitkeep
!data/.gitkeep

# Raw and Rendered Media Extensions
*.mp4
*.mkv
*.webm
*.avi
*.mov
*.wav
*.mp3
*.flac
*.m4a
*.aac
*.ass
*.srt
*.vtt

# --- SQLite Databases, WAL Journals & Caches ---
data/*.db
data/*.sqlite
data/*.sqlite3
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# --- Machine Learning Models, Checkpoints & Weights ---
weights/
models/*.pt
models/*.pth
models/*.bin
models/*.onnx
models/*.engine
models/*.safetensors
models/*.tflite
models/*.h5
models/*.pb

# --- Upstream Clones & Third-Party Research Repositories ---
research/upstream/

# --- Environment Variables, API Keys & Secret Tokens ---
# CRITICAL: Never commit operational API tokens or credentials
.env
.env.local
.env.*.local
*.secret
*.key
*.pem
*.crt
client_secret*.json
credentials.json
*service-account*.json

# --- IDE, Editor & OS Artifacts ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
